<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/styles.css">
    <title>DueToday</title>
</head>
<body>
    <%- include('./partials/navbar') %>

    <div class="container mt-4">
        <h2>Upcoming Deadlines</h2>
        <a href="/add" class="btn btn-cream-primary mb-3">+ Add New Task</a>

        <h4 class="mt-3 text-cream-dark">Pending Tasks</h4>
        <table class="table table-bordered bg-white">
            <thead>
                <tr>
                    <th>Module</th>
                    <th>Task Name</th>
                    <th>Due Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% pending.forEach(task => { %>
                    <tr class="<%= task.isUrgent ? 'task-urgent' : '' %>">
                        <td><%= task.moduleCode %></td>
                        <td><%= task.taskName %></td>
                        <td>
                            <%= task.dueDate %>
                            <% if (task.isUrgent) { %> (⚠️ Urgent!) <% } %>
                        </td>
                        <td>
                            <form action="/toggle/<%= task.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-success">Done</button>
                            </form>
                            <a href="/edit/<%= task.id %>" class="btn btn-sm btn-warning">Edit</a>
                            <form action="/delete/<%= task.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <h4 class="mt-5 text-cream-dark">Completed Tasks</h4>
        <table class="table table-bordered bg-white">
            <thead>
                <tr>
                    <th>Module</th>
                    <th>Task Name</th>
                    <th>Due Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% completed.forEach(task => { %>
                    <tr class="task-completed">
                        <td class="text-decoration-line-through text-muted"><%= task.moduleCode %></td>
                        <td class="text-decoration-line-through text-muted"><%= task.taskName %></td>
                        <td class="text-muted"><%= task.dueDate %></td>
                        <td>
                            <form action="/toggle/<%= task.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-secondary">Undo</button>
                            </form>
                            <form action="/delete/<%= task.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>