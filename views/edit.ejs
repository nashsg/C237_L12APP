<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Task</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('./partials/navbar') %>
    
    <div class="container mt-4" style="max-width: 500px;">
        <h2 class="text-cream-dark">Edit Task</h2>
        <form action="/edit/<%= task.id %>" method="POST">
            <div class="mb-3">
                <label class="form-label">Module Code:</label>
                <input name="moduleCode" value="<%= task.moduleCode %>" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Task Name:</label>
                <input name="taskName" value="<%= task.taskName %>" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Due Date:</label>
                <input type="date" name="dueDate" value="<%= task.dueDate %>" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-warning">Update Task</button>
            <a href="/" class="btn btn-secondary">Back</a>
        </form>
    </div>
</body>
</html>
